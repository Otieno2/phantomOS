# Build scratch, never source (§9: "ISOs stay out of git").
*.iso
*.squashfs
live/binary/
live/chroot/
live/cache/
live/tmp/
live/.build/
live/.lock

# Built packages land here; the definitions in packages/ are what is versioned.
pool/
build/
*.deb
*.udeb

# Generated by live-build from live/auto/config — committing these would put a second
# copy of the build configuration in the tree, and the stale one always wins an argument.
#
# The list below is the *complete* one, established by reading a configured tree rather than by
# recalling it. `lb config` writes: apt, archives, binary, bootloaders, bootstrap, chroot, common,
# debian-installer, hooks, includes, includes.*, package-lists, packages, packages.binary,
# packages.chroot, preseed, rootfs, source. Four of those also hold committed source and are named
# individually elsewhere in this file or not at all:
#   apt/            — live/config/apt/apt.conf is ours (§9.1 records why it is inert and kept only
#                     as the record of that), so the directory is not ignorable.
#   archives/       — phantomos.list.chroot and phantomos.key.chroot are the committed contract
#                     with live-build about where the pool lives. Not ignorable.
#   package-lists/  — ours are source; the generated ones are ignored below.
#   hooks/          — M1 ships none. Ignored wholesale, with the consequence in its rule below.
/live/config/binary
/live/config/bootloaders
/live/config/bootstrap
/live/config/chroot
/live/config/common
/live/config/debian-installer
/live/config/includes
/live/config/includes.*
/live/config/packages
/live/config/packages.binary
/live/config/packages.chroot
/live/config/preseed
/live/config/rootfs
/live/config/source
# Symlinks into the host's /usr/share/live/build/hooks, i.e. absolute paths on a machine that is
# not the image. M1 has no hooks of its own, so this directory is empty in the repo and therefore
# absent from a clone — git does not track empty directories. That is intended and safe:
# build-iso.sh globs hooks with `|| true`. A real hook is added deliberately with `git add -f`.
/live/config/hooks/

# Generated by scripts/gen-package-lists.sh from manifests/*.pkgs (manifests are source).
# live/config/archives/*.list.chroot is NOT generated — it is the committed contract with
# live-build about where the pool lives on the build host.
/live/config/package-lists/*.list.chroot

# build-iso.sh re-execs a private copy of itself into the work tree (§9.1); if a run is ever
# pointed at the repo by mistake this is what it leaves behind.
.build-iso.running.sh

# config-audit.sh's by-product. An audit output, not a source file.
lb-config.log

# OneDrive invents these. `logs/evidence/M0-bootA-syslinux-menu - Copy.png` is a byte-identical
# duplicate of a cited evidence PNG and was made by the sync engine, not by anyone here; it stays
# out of the record so git is never the thing that makes a file nobody authored look official.
* - Copy.*
*conflict*

# Private keys. Only public keyrings are ever committed, and they live under
# live/config/archives/ with a .key.chroot name.
*.secret
*.p8
.gnupg/
